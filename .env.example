# Meta Model API — keep this file private and never expose the key to the browser.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
SPARK_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1
VOICE_MODEL=muse-voice-transcribe-1.0

# Video and concurrency limits
ANALYSIS_FPS=15
MAX_LONG_EDGE=1280
MAX_VIDEO_SECONDS=300
MAX_UPLOAD_BYTES=1073741824
SAM_CONCURRENCY=4
SPARK_CONCURRENCY=6
RPM_LIMIT=50
FILES_TTL_SECONDS=604800

# Local execution
MOTIONLEDGER_OFFLINE=0
MOTIONLEDGER_DEMO_MODE=0
DATA_DIR=../../data
DATABASE_URL=sqlite:///../../data/motionledger.db
